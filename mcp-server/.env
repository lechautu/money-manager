# Required
PORT=3100
MCP_PATH=/mcp
MCP_BEARER=change-me-to-a-strong-secret

# Tool Gateway backend URL (where tool calls are proxied to)
MM_API_BASE_URL=http://localhost:3200

# Security
REQUIRE_APPROVAL_GUARD=true
# APPROVAL_GUARD_DENYLIST=import_system_data,bulk_delete_transactions
# APPROVAL_GUARD_ALLOWLIST=

# Optional
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=30000
