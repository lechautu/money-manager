# Required
PORT=3200
GATEWAY_HOST=127.0.0.1
JWT_SECRET=change-me-to-a-strong-secret
APPROVAL_TOKEN_SECRET=change-me-to-another-strong-secret

# Security
TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
